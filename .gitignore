# ============================================================
# MITM Lab — .gitignore
# ============================================================

# Session data (contains real user traffic — NEVER commit!)
mitm_lab_sessions/
capture.pcap
capture.pcap.*
*.pcap
*.pcapng
*.cap

# Logs
*.log
script.log
arpspoof_*.log
tcpdump.log

# Generated reports (may contain real data)
websites_visited.txt
session_info.txt
session_summary.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
ENV/
.venv/

# Obsidian (editor settings — not part of project)
.obsidian/
.trash/

# OS files
.DS_Store
Thumbs.db
desktop.ini
*~

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak
*.orig
*.rej
